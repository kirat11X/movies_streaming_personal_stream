# Personal Stream Movies Server configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE=personal-stream-movies
FRONTEND_ORIGIN=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-access-secret
SECRET_REFRESH_KEY=replace-with-a-different-long-random-refresh-secret
# Set true only when serving over HTTPS. Leave false for local HTTP development.
COOKIE_SECURE=false

# ─── Gemini review ranking ───
# Used by PATCH /movie/:imdb_id/review to classify a curator review into one of
# the sentiments stored in the `rankings` collection.
GEMINI_API_KEY=your-generative-language-api-key
# Must be a model your key has generateContent quota for. Check with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# Note: gemini-2.0-flash currently has a zero free-tier quota on new keys.
GEMINI_MODEL=gemini-flash-latest
# {rankings} is replaced with the comma-separated sentiment names before sending.
BASE_PROMPT_TEMPLATE=Classify the following movie review into exactly one of these sentiments: {rankings}. Respond with only the sentiment name, nothing else. Review:

# ─── Recommendations ───
# How many titles GET /recommended returns. Defaults to 5 when unset.
RECOMMENDED_MOVIE_LIMIT=5
